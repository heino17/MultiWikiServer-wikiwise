datasource db {
  provider = "sqlite"
}

generator client {
  provider        = "prisma-client"
  output          = "client"
  previewFeatures = ["partialIndexes"]
}

generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

// ---------------------------------------------------------------------------
// Tiddler storage
// ---------------------------------------------------------------------------

model Bag {
  id             String          @id @default(uuid(7))
  name           String          @unique
  created        DateTime        @default(now())
  updated        DateTime        @updatedAt
  description    String
  /// user_id of the user who created this bag; editable only by the
  /// owner or the site admin account ("admin"). No FK (auth module).
  owner_user_id  String?
  permissions    BagPermission[]
  tiddlers       Tiddler[]
  recipe_bags    RecipeBag[]
  tiddler_events TiddlerEvent[]

  @@map("bag")
}

// role_id references the auth module's roles table; no FK declared here —
// permission and auth tables are owned by separate modules.
model BagPermission {
  bag_id  String
  role_id String
  level   BagPermissionLevel
  bag     Bag                @relation(fields: [bag_id], references: [id], onDelete: Cascade)

  @@id([bag_id, role_id])
  @@map("bag_permission")
}

model Tiddler {
  bag_id   String
  title    String
  created  DateTime @default(now())
  updated  DateTime @updatedAt
  revision BigInt   @default(0)
  // partition_key String @default("")
  /// [Tiddler_fields]
  fields   Json
  bag      Bag      @relation(fields: [bag_id], references: [id], onDelete: Cascade)

  @@id([bag_id, title])
  @@index([title])
  @@map("tiddler")
}

model TiddlerEvent {
  seq    Int              @id @default(autoincrement())
  bag_id String
  title  String
  type   TiddlerEventType

  bag Bag @relation(fields: [bag_id], references: [id], onDelete: Cascade)

  @@index([bag_id, seq])
  @@map("tiddler_event")
}

enum TiddlerEventType {
  save
  delete
}

model Template {
  id            String               @id @default(uuid(7))
  name          String               @unique
  created       DateTime             @default(now())
  updated       DateTime             @updatedAt
  /// user_id of the user who created this template; editable only by the
  /// owner or the site admin account ("admin"). No FK (auth module).
  owner_user_id String?
  /// [Template_type]
  type          String
  /// [Template_definition]
  definition    Json
  recipes       Recipe[]
  permissions   TemplatePermission[]

  @@map("template")
}

model TemplatePermission {
  template_id String
  role_id     String
  level       TemplatePermissionLevel
  template    Template                @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@id([template_id, role_id])
  @@map("template_permission")
}

model Recipe {
  id            String             @id @default(uuid(7))
  slug          String             @unique
  created       DateTime           @default(now())
  updated       DateTime           @updatedAt
  /// user_id of the user who created this wiki; deletable only by the
  /// owner or the site admin account ("admin"). role_id references the
  /// auth module, no FK declared here.
  owner_user_id String?
  template_id   String
  /// [Recipe_definition]
  definition    Json
  template      Template           @relation(fields: [template_id], references: [id], onDelete: Restrict)
  recipe_bags   RecipeBag[]
  permissions   RecipePermission[]
  /// [Recipe_plugins]
  plugins       Json
  compiledAt    DateTime

  @@map("recipe")
}

model RecipePermission {
  recipe_id String
  role_id   String
  level     RecipePermissionLevel
  recipe    Recipe                @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@id([recipe_id, role_id])
  @@map("recipe_permission")
}

model RecipeBag {
  recipe_id   String
  bag_id      String
  priority    Int
  is_writable Boolean
  prefix      String
  recipe      Recipe  @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  bag         Bag     @relation(fields: [bag_id], references: [id], onDelete: Restrict)

  @@id([recipe_id, bag_id, is_writable, prefix])
  @@map("recipe_bag")
}

model Settings {
  key     String   @id
  value   String
  updated DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Auth — managed by the auth module, separate from tiddler storage.
// No FK references cross from auth into tiddler/recipe/bag tables.
// ---------------------------------------------------------------------------

model Roles {
  role_id       String  @id @default(uuid(7))
  role_name     String  @unique()
  description   String?
  /// Grants teacher/team-admin capabilities (manage the users one invites,
  /// see all wikis/bags, exemption from the own-wiki limit). Named "teacher"
  /// historically, but the capability rides on this flag: the role may be
  /// renamed freely.
  is_teacher    Boolean @default(false)
  /// user_id of the user who created this role; editable only by the
  /// owner or the site admin account ("admin"). No FK (auth module).
  owner_user_id String?
  users         Users[]

  @@map("roles")
}

model Users {
  user_id       String  @id @default(uuid(7))
  username      String  @unique
  email         String? @unique
  password      String
  /// owner of the account is the user themself; only the owner or the
  /// site admin account ("admin") may edit the record. User records are
  /// always self-owned (see UserDataAdapter.saveRow). No FK.
  owner_user_id String?

  // MySQL: multiple NULLs are allowed in unique columns and there is no way to make a partial index.
  // SQL Server: the `where` clause is required to get the "multiple NULLs allowed" behavior.
  // Everything else: multiple nulls are allowed in unique columns and partial indexes also work
  resetCode  String?    @unique(where: { resetCode: { not: null } })
  created_at DateTime   @default(now())
  last_login DateTime?
  /// How many wikis this user may create. NULL means unlimited, 0 means
  /// none. Only enforced for non-teacher, non-admin users (students).
  /// Default 0 so accounts are locked until a teacher grants a limit.
  wiki_limit Int?       @default(0)
  sessions   Sessions[]
  roles      Roles[]

  @@map("users")
}

model Sessions {
  session_id    String   @id
  created_at    DateTime @default(now())
  last_accessed DateTime
  session_key   String?
  user_id       String
  user          Users    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Pinboard — loose notes ("Zettel") pinned to a wall. Not part of the auth
// module: author and scope ids are plain strings without FK declarations.
// ---------------------------------------------------------------------------

model PinboardNote {
  id             String                 @id @default(uuid(7))
  /// user_id of the author. No FK (auth module).
  author_user_id String
  /// Snapshot of the author's username, so notes stay readable even if the
  /// account is later renamed or removed.
  author_name    String
  /// "GLOBAL" (everyone), "ROLE" (scope_id = role_id) or "USER"
  /// (scope_id = user_id). Kept as a string, not an enum, so new scopes can
  /// be added without a migration.
  scope_type     String
  /// role_id (ROLE) or user_id (USER); null for GLOBAL.
  scope_id       String?
  body           String
  color          String                 @default("yellow")
  is_important   Boolean                @default(false)
  is_active      Boolean                @default(true)
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt
  expires_at     DateTime?
  reads          PinboardNoteRead[]
  positions      PinboardNotePosition[]

  @@index([is_active, scope_type])
  @@map("pinboard_note")
}

model PinboardNoteRead {
  note_id      String
  user_id      String
  read_at      DateTime?
  dismissed_at DateTime?
  note         PinboardNote @relation(fields: [note_id], references: [id], onDelete: Cascade)

  @@id([note_id, user_id])
  @@map("pinboard_note_read")
}

/// Where a single user has placed a note on the wall (the arrangement is
/// per-user, not shared). x/y are fractions (0..1) of the wall dimensions
/// describing the note's centre, snapped to the wall raster by the UI.
model PinboardNotePosition {
  note_id String
  user_id String
  x       Float
  y       Float
  note    PinboardNote @relation(fields: [note_id], references: [id], onDelete: Cascade)

  @@id([note_id, user_id])
  @@map("pinboard_note_position")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BagPermissionLevel {
  A_read
  B_write
  C_admin
}

enum RecipePermissionLevel {
  A_read
  B_write
}

enum TemplatePermissionLevel {
  A_read
  B_write
}
